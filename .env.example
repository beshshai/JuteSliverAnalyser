# Copy these into Render → your service → Environment, not into a committed .env file.

# Supabase → Project Settings → Database → Connection string (URI). Use the
# "Session pooler" or direct connection string, e.g.:
# postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase → Storage → create a bucket (mark it Public), put its name here
SUPABASE_BUCKET=jute-uploads
